{
  "ConnectionStrings": {
    "Database": "Host=goldentable.database;Port=5432;Database=goldentable;Username=postgres;Password=postgres;Include Error Detail=true",
    "Cache": "goldentable.redis:6379,abortConnect=false"
  },
  "Authentication": {
    "Audience": "account",
    "TokenValidationParameters": {
      "ValidIssuers": ["http://goldentable.identity:8080/realms/goldentable","http://localhost:18080/realms/goldentable"]
    },
    "MetadataAddress": "http://goldentable.identity:8080/realms/goldentable/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Keycloak": {
    "HealthUrl": "http://goldentable.identity:8080/health/",
    "AuthorizationUrl": "http://localhost:18080/realms/goldentable/protocol/openid-connect/auth",
    "TokenUrl": "http://localhost:18080/realms/goldentable/protocol/openid-connect/token",
    "ClientId": "goldentable-confidential-client"
  },
  "Catalog": {
    "Outbox": {
      "IntervalInSeconds": 10,
      "BatchSize": 10
    }
  }
}
