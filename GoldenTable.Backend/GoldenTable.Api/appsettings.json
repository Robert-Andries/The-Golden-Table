{
  "ConnectionStrings": {
    "Database": "",
    "Cache": ""
  },
  "Authentication": {
    "Audience": "",
    "TokenValidationParameters": {
      "ValidIssuers": []
    },
    "MetadataAddress": "",
    "RequireHttpsMetadata": false
  },
  "Keycloak": {
    "HealthUrl": "",
    "AuthorizationUrl": "",
    "TokenUrl": "",
    "ClientId": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "GoldenTable.Api"
    }
  },
  "AllowedHosts": "*",
  "Catalog": {
    "Outbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 50
    }
  }
}
