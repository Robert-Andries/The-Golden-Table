# GoldenTable API base URL
VITE_API_BASE_URL=http://localhost:5000

# Keycloak Identity Server URL (matches compose.yaml port 18080)
VITE_KEYCLOAK_URL=http://localhost:18080

# Keycloak Realm Name
VITE_KEYCLOAK_REALM=goldentable

# Keycloak Public Client ID for SPA
VITE_KEYCLOAK_CLIENT_ID=goldentable-public-client
